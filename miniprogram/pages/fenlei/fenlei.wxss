/* pages/fenlei/fenlei.wxss */.search{
    display: block;
    margin: auto;
    width: 90% !important;
    height: 70rpx;
    display: flex;
    border-radius: 50rpx;
    padding: 0rpx 10rpx;
  }
  input{
    display: block;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    /* font-weight: 600; */
    height:100%;
    width:100%;
    text-align: center;
  }
  .aax{
      margin:10rpx auto 10rpx;
      width: 90%;
      border-radius: 25rpx;
      border: 4rpx solid black;
  }
  .searchimg{
	width:55rpx;
	height:55rpx;
	display:block;
	 margin:auto 10rpx;
  }
  .tab-h {
    height: 80rpx;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    line-height: 80rpx;
    background: #f7f7f7;
    font-size: 14px;
    white-space: nowrap;
    z-index: 99;
    margin: 15rpx 0rpx;
  }
  
  .tab-item {
    text-align: center;
    margin: 0 20rpx;
    display: inline-block;
    border-radius: 25rpx;
    padding: 0rpx 15rpx;
  }
  
  .tab-item.active {
    font-weight: bold;
    color: #14685d;
    border-radius: 25rpx;
    padding: 0rpx 15rpx;
    position: relative;
  }
  
  .tab-h .tab-item:nth-child(1).active:after {
    width: 52rpx;
  }
  .content{
    width: 100%;
    margin-top:20rpx;
    overflow: hidden;
  }
  .img-div1{
    margin: 2%;
    width: 45%;
    float: left;
    box-shadow: 12rpx 10rpx 25rpx grey;
    border-radius: 25rpx;
  }
  .mess1{
    font-weight: bold;
	font-size: 35rpx;
	width: 90%;
	margin:10rpx auto;
  }
  .mess2{
    /* font-weight: bold; */
    font-size: 26rpx;
    margin-left: 20rpx;
    color: rgb(92, 92, 92);
  }
  .mess3{
    /* font-weight: bold; */
    font-size: 30rpx;
    color: rgb(243, 111, 3);
    font-weight: bold;
    margin-left: 20rpx;
    margin-bottom: 20rpx;
  }
  .cookimg{
    width: 100%;
    height: 220rpx;
    
    /* background-color: #000000; */
  }
  .zanwu{
	width: 350rpx;
	height: 350rpx;
	margin: 20rpx auto;
	display: block;
}