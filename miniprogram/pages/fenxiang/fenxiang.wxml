<view  class="box" >
<form  bindsubmit="btnSub">
  <view class="ptboxms">
<view class="ptbox">
<view class="qianbiao">名称:</view>
<input class="jibenkuang" value="{{name}}" name="name"placeholder="请输入标题" placeholder-style="color: #88888891;"type="text"/>
</view>
</view>
  <view class="qianbiao">照片:</view>
  <view wx:if="{{jzimg==0}}"class="tpboximg">
    <image src="../../images/shangchuan.png"bindtap="chooseImage"class="imgs"></image>
    <view class="xstext">添加照片，最多9张</view>
  </view>
  <view wx:if="{{jzimg==1}}"class="tpboximgs">
    <view class="qubox">
      <image data-id="{{index}}"wx:for="{{temp_imgs}}"src="../../images/quxiao.png"mode="aspectFill"class="smallimgs"bindtap="quxiao"></image>
      <image src="../../images/shangchuan.png"bindtap="chooseImage"class="cimgs"></image>
    </view>
    <image wx:for="{{temp_imgs}}"src="{{item}}"mode="aspectFill" class="imgs"></image>
  </view>
  <view class="ptboxms">
    <view class="qianbiao">描述:</view>
    <textarea  maxlength="{{500}}"value="{{mess}}"show-confirm-bar="{{false}}"disable-default-padding="{{false}}"class="miaoshu"name="mess"adjust-position="{{true}}"cursor-spacing="{{120}}"placeholder-class="phcolor"tyle="OVERFLOW:hidden"></textarea>
  </view>
  <view class="btns">
    <button class="btt"form-type="submit">发布</button>
  </view>
</form>
</view>