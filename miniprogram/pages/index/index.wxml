<!-- 搜索 -->
<view class="aax">
	<view class="search">
		<input class="sousuo" placeholder="请输入要搜索的内容" bindconfirm="search" bindinput="emailInput" value="{{value}}" confirm-type="done"></input>
		<image src="/images/sousuo.png" style="width:60rpx;height:55rpx;margin:auto;"></image>
	</view>
</view>
<!-- 轮播图 -->
<view class="banner" >
  <swiper class="banner_1" autoplay="true" circular="true" interval="4000" indicator-dots="true">
    <swiper-item >
      <image mode="aspectFill"class="bannimg" src="/images/banner1.png"></image>
    </swiper-item>
    <swiper-item >
      <image mode="aspectFill"class="bannimg"src="/images/banner2.png"></image>
    </swiper-item>
    <swiper-item >
      <image mode="aspectFill"class="bannimg"src="/images/banner3.png"></image>
    </swiper-item>
  </swiper>
</view>
<!-- 业务模块 -->
<view class="zhonbox">
  <view class="neibox1"bindtap="clickfu1">
    <image src="../../images/weixiu.png"class="gongimg"></image>
    <view class="gongbox">
      <view class="gb1">废品回收</view>
      <view class="gb2">废品拟回收</view>
    </view>
  </view>
  <view class="neibox2"bindtap="clickfu2">
    <image src="../../images/yijian.png"class="gongimg"></image>
    <view class="gongbox">
      <view class="gb1">分享心得</view>
      <view class="gb2">填写回收经验</view>
    </view>
  </view>
</view>

<view class="titless">
    回收站点推荐 >
</view>
<view wx:if="{{dataObj.length}}" class='content'>
      <view class='img-div1' bindtap='introduce'data-id="{{index}}"data-url="{{item}}" data-item="{{item}}" wx:key="id"wx:for-index="index"wx:for="{{dataObj}}">
        <image class="cookimg" mode="aspectFill" src="{{item.img}}"></image>

        <view class="mess1">{{item.name}}</view>
        <view class="mess3">位置:{{item.area}}</view>
        <view class="mess3">类型:{{item.type}}</view>

      </view>
</view>
<view wx:else class="content" >
	<image src="../../images/zanwu.png"class="zanwu" mode="aspectFill"/>
</view>