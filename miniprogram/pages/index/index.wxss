.search{
    display: block;
    margin: auto;
    width: 90% !important;
    height: 70rpx;
    display: flex;
    border-radius: 50rpx;
    padding: 0rpx 10rpx;
  }
  input{
    display: block;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    /* font-weight: 600; */
    height:100%;
    width:100%;
    text-align: center;
  }
  .aax{
      margin:10rpx auto 10rpx;
      width: 90%;
      border-radius: 25rpx;
      border: 4rpx solid black;
  }
  .searchimg{
	width:55rpx;
	height:55rpx;
	display:block;
	 margin:auto 10rpx;
  }
  /* Banner */
