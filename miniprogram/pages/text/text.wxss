  /* 评论 */
  .write{
      float: inline-start;
      z-index: 3;
      position: fixed;
      width: 100%;
      height: 70%;
      background: #ffffff;
      top:70%;
      animation: wtmove 0.5s infinite linear;
      animation-iteration-count:1;
  }
  @keyframes wtmove{
      0%   {
          position: fixed;
          top: 100%;
          opacity: 0.5;
      }
      100%  {
          position: fixed;
          top:70%;
          opacity: 1;
      }
  }
